@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                color: #333;
            }

            .page-header {
                background: linear-gradient(135deg, #007FFF 0%, #0056b3 100%);
                color: white;
                padding: 2rem;
                border-radius: 15px;
                margin-bottom: 2rem;
            }

                .page-header h1 {
                    font-size: 2rem;
                    font-weight: bold;
                    margin: 0;
                }

                .page-header p {
                    margin: 0;
                    opacity: 0.9;
                }

            .btn-create {
                background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
                color: white;
                padding: 0.75rem 1.5rem;
                border-radius: 10px;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                transition: all 0.3s ease;
                margin-bottom: 1.5rem;
            }

                .btn-create:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
                    color: white;
                }

            .table-container {
                background: white;
                border-radius: 15px;
                padding: 1.5rem;
                box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            }

            .table {
                margin-bottom: 0;
            }

                .table thead th {
                    background: #f8f9fa;
                    border-bottom: 2px solid #007FFF;
                    color: #333;
                    font-weight: 600;
                    padding: 1rem;
                }

                .table tbody td {
                    padding: 1rem;
                    vertical-align: middle;
                }

                .table tbody tr:hover {
                    background-color: #f8f9fa;
                }

            .status-badge {
                padding: 0.25rem 0.75rem;
                border-radius: 20px;
                font-size: 0.8rem;
                font-weight: 500;
            }

            .status-confirmed {
                background: #d4edda;
                color: #155724;
            }

            .status-pending {
                background: #fff3cd;
                color: #856404;
            }

            .status-cancelled {
                background: #f8d7da;
                color: #721c24;
            }

            .btn-action {
                padding: 0.25rem 0.5rem;
                margin: 0 0.2rem;
                border-radius: 5px;
            }

            .search-box {
                border-radius: 10px;
                border: 1px solid #ddd;
                padding: 0.5rem 1rem;
                width: 300px;
            }

                .search-box:focus {
                    border-color: #007FFF;
                    outline: none;
                    box-shadow: 0 0 0 0.2rem rgba(0, 127, 255, 0.25);
                }
    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Page Header -->
        <div class="page-header">
            <h1>
                <i class="bi bi-ticket-detailed"></i> @ViewData["Title"]
            </h1>
            <p>Manage all customer bookings</p>
        </div>

        <!-- Search and Create Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <form asp-action="Index" method="get" class="d-flex">
                <input type="text" name="searchString" class="search-box" placeholder="Search by customer or event..." value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-primary ms-2" style="border-radius: 10px;">
                    <i class="bi bi-search"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2" style="border-radius: 10px;">
                    <i class="bi bi-arrow-repeat"></i> Clear
                </a>
            </form>
            <a asp-action="Create" class="btn-create">
                <i class="bi bi-plus-circle"></i> New Booking
            </a>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Table Container -->
        <div class="table-container">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Event</th>
                            <th>Venue</th>
                            <th>Customer</th>
                            <th>Booking Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.BookingID</strong></td>
                                <td>@item.Event?.EventName</td>
                                <td>@item.Venue?.VenueName</td>
                                <td>@item.CustomerName</td>
                                <td>@item.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="status-badge @(item.Status == "Confirmed" ? "status-confirmed" : (item.Status == "Pending" ? "status-pending" : "status-cancelled"))">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.BookingID" class="btn btn-info btn-action" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.BookingID" class="btn btn-warning btn-action" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.BookingID" class="btn btn-danger btn-action" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No bookings found.</p>
                    <a asp-action="Create" class="btn btn-primary">Create your first booking</a>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
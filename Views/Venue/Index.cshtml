@model IEnumerable<EventEase.Models.Venue>

@{
    ViewData["Title"] = "Venues Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                color: #333;
            }

            .page-header {
                background: linear-gradient(135deg, #007FFF 0%, #0056b3 100%);
                color: white;
                padding: 2rem;
                border-radius: 15px;
                margin-bottom: 2rem;
            }

                .page-header h1 {
                    font-size: 2rem;
                    font-weight: bold;
                    margin: 0;
                }

            .btn-create {
                background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
                color: white;
                padding: 0.75rem 1.5rem;
                border-radius: 10px;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                transition: all 0.3s ease;
                margin-bottom: 1.5rem;
            }

                .btn-create:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
                    color: white;
                }

            .venue-card {
                background: white;
                border-radius: 15px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(0,0,0,0.08);
                transition: all 0.3s ease;
                height: 100%;
            }

                .venue-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
                }

            .venue-image {
                height: 200px;
                object-fit: cover;
                width: 100%;
            }

            .venue-body {
                padding: 1.5rem;
            }

            .venue-title {
                font-size: 1.25rem;
                font-weight: bold;
                margin-bottom: 0.5rem;
            }

            .venue-location {
                color: #6c757d;
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }

            .venue-capacity {
                display: inline-block;
                background: #e9ecef;
                padding: 0.25rem 0.75rem;
                border-radius: 20px;
                font-size: 0.8rem;
            }

            .search-box {
                border-radius: 10px;
                border: 1px solid #ddd;
                padding: 0.5rem 1rem;
                width: 300px;
            }

                .search-box:focus {
                    border-color: #007FFF;
                    outline: none;
                    box-shadow: 0 0 0 0.2rem rgba(0, 127, 255, 0.25);
                }
    </style>
</head>
<body>
   

        <!-- Search and Create Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <form asp-action="Index" method="get" class="d-flex">
                <input type="text" name="searchString" class="search-box" placeholder="Search by name or location..." value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-primary ms-2" style="border-radius: 10px;">
                    <i class="bi bi-search"></i> Search
                </button>
            </form>
            <a asp-action="Create" class="btn-create">
                <i class="bi bi-plus-circle"></i> Add Venue
            </a>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

<!-- Venue Cards Grid -->
@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="venue-card">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://picsum.photos/id/106/400/300" : item.ImageUrl)" 
                         class="venue-image" 
                         alt="@item.VenueName"
                         onerror="this.src='https://picsum.photos/id/106/400/300'">
                    <div class="venue-body">
                        <h5 class="venue-title">@item.VenueName</h5>
                        <p class="venue-location">
                            <i class="bi bi-geo-alt"></i> @item.Location
                        </p>
                        <p>
                            <span class="venue-capacity">
                                <i class="bi bi-people"></i> Capacity: @item.Capacity
                            </span>
                        </p>
                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@item.VenueID" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.VenueID" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.VenueID" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-building" style="font-size: 4rem; color: #ccc;"></i>
        <p class="text-muted mt-3">No venues found.</p>
        <a asp-action="Create" class="btn btn-primary">Add your first venue</a>
    </div>
}        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-building" style="font-size: 4rem; color: #ccc;"></i>
                <p class="text-muted mt-3">No venues found.</p>
                <a asp-action="Create" class="btn btn-primary">Add your first venue</a>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
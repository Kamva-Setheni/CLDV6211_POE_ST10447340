@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Events Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                color: #333;
            }

            .page-header {
                background: linear-gradient(135deg, #007FFF 0%, #0056b3 100%);
                color: white;
                padding: 2rem;
                border-radius: 15px;
                margin-bottom: 2rem;
            }

            .btn-create {
                background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
                color: white;
                padding: 0.75rem 1.5rem;
                border-radius: 10px;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                transition: all 0.3s ease;
            }

                .btn-create:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
                    color: white;
                }

            .event-card {
                background: white;
                border-radius: 15px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(0,0,0,0.08);
                transition: all 0.3s ease;
                height: 100%;
                position: relative;
            }

                .event-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
                }

            .event-date {
                position: absolute;
                top: 15px;
                right: 15px;
                background: #007FFF;
                color: white;
                padding: 5px 12px;
                border-radius: 20px;
                font-size: 0.8rem;
                font-weight: bold;
            }

            .event-body {
                padding: 1.5rem;
            }

            .event-title {
                font-size: 1.25rem;
                font-weight: bold;
                margin-bottom: 0.5rem;
                padding-right: 80px;
            }

            .event-venue {
                color: #007FFF;
                font-size: 0.9rem;
                margin-bottom: 0.5rem;
            }

            .event-description {
                color: #6c757d;
                font-size: 0.9rem;
                margin-top: 0.5rem;
            }

            .search-box {
                border-radius: 10px;
                border: 1px solid #ddd;
                padding: 0.5rem 1rem;
                width: 300px;
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Page Header -->
        <div class="page-header">
            <h1>
                <i class="bi bi-calendar-event"></i> @ViewData["Title"]
            </h1>
            <p>Manage all events in the system</p>
        </div>

        <!-- Search and Create Bar -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <form asp-action="Index" method="get" class="d-flex">
                <input type="text" name="searchString" class="search-box" placeholder="Search by event name..." value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-primary ms-2" style="border-radius: 10px;">
                    <i class="bi bi-search"></i> Search
                </button>
            </form>
            <a asp-action="Create" class="btn-create">
                <i class="bi bi-plus-circle"></i> Create Event
            </a>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Event Cards Grid -->
        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="event-card">
                            <div class="event-date">
                                <i class="bi bi-calendar"></i> @item.EventDate.ToString("MMM dd, yyyy")
                            </div>
                            <div class="event-body">
                                <h5 class="event-title">@item.EventName</h5>
                                <p class="event-venue">
                                    <i class="bi bi-building"></i> @(item.Venue?.VenueName ?? "No venue assigned")
                                </p>
                                <p class="event-description">
                                    @(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                                </p>
                                <div class="mt-3">
                                    <a asp-action="Details" asp-route-id="@item.EventID" class="btn btn-info btn-sm">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.EventID" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.EventID" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size: 4rem; color: #ccc;"></i>
                <p class="text-muted mt-3">No events found.</p>
                <a asp-action="Create" class="btn btn-primary">Create your first event</a>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>